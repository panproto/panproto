{
  "lexicon": 1,
  "id": "dev.panproto.vcs.cstComplement",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["dataId", "objectHash", "createdAt"],
        "properties": {
          "dataId": { "type": "string", "maxLength": 64 },
          "objectHash": { "type": "string", "maxLength": 64 },
          "blob": { "type": "blob", "accept": ["application/x-msgpack"], "maxSize": 16777216 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
