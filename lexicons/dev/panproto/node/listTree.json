{
  "lexicon": 1,
  "id": "dev.panproto.node.listTree",
  "defs": {
    "main": {
      "type": "query",
      "description": "Lists entries (files and directories) at a given path within a commit tree from the git mirror.",
      "parameters": {
        "type": "params",
        "required": ["repo"],
        "properties": {
          "repo": { "type": "string", "maxLength": 256 },
          "ref": { "type": "string", "maxLength": 256 },
          "path": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ref", "commit", "path", "entries"],
          "properties": {
            "ref": { "type": "string", "maxLength": 256 },
            "commit": { "type": "string", "maxLength": 64 },
            "path": { "type": "string" },
            "entries": {
              "type": "array",
              "items": { "type": "ref", "ref": "#treeEntry" }
            }
          }
        }
      }
    },
    "treeEntry": {
      "type": "object",
      "required": ["name", "type", "oid"],
      "properties": {
        "name": { "type": "string", "maxLength": 256 },
        "type": { "type": "string", "knownValues": ["file", "dir"] },
        "oid": { "type": "string", "maxLength": 64 },
        "size": { "type": "integer" }
      }
    }
  }
}
