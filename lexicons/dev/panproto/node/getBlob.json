{
  "lexicon": 1,
  "id": "dev.panproto.node.getBlob",
  "defs": {
    "main": {
      "type": "query",
      "description": "Returns the content of a file (blob) at a given path and ref from the git mirror.",
      "parameters": {
        "type": "params",
        "required": ["repo", "path"],
        "properties": {
          "repo": { "type": "string", "maxLength": 256 },
          "ref": { "type": "string", "maxLength": 256 },
          "path": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["path", "commit", "binary", "size"],
          "properties": {
            "path": { "type": "string" },
            "commit": { "type": "string", "maxLength": 64 },
            "binary": { "type": "boolean" },
            "size": { "type": "integer" },
            "content": { "type": "string" }
          }
        }
      }
    }
  }
}
