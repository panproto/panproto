{
  "lexicon": 1,
  "id": "dev.panproto.schema.inductive",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "objectHash", "createdAt"],
        "properties": {
          "name": { "type": "string", "maxLength": 256 },
          "description": { "type": "string", "maxLength": 2560 },
          "paramCount": { "type": "integer" },
          "constructors": {
            "type": "array",
            "items": { "type": "ref", "ref": "#constructorSummary" },
            "maxLength": 256
          },
          "objectHash": { "type": "string", "maxLength": 64 },
          "blob": { "type": "blob", "accept": ["application/x-msgpack"], "maxSize": 1048576 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "constructorSummary": {
      "type": "object",
      "required": ["name", "arity"],
      "properties": {
        "name": { "type": "string", "maxLength": 256 },
        "arity": { "type": "integer" },
        "isRecursive": { "type": "boolean" }
      }
    }
  }
}
