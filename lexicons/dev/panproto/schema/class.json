{
  "lexicon": 1,
  "id": "dev.panproto.schema.class",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "objectHash", "createdAt"],
        "properties": {
          "name": { "type": "string", "maxLength": 256 },
          "description": { "type": "string", "maxLength": 2560 },
          "params": {
            "type": "array",
            "items": { "type": "string", "maxLength": 128 },
            "maxLength": 32
          },
          "signatureCount": { "type": "integer" },
          "axiomCount": { "type": "integer" },
          "objectHash": { "type": "string", "maxLength": 64 },
          "blob": { "type": "blob", "accept": ["application/x-msgpack"], "maxSize": 1048576 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
