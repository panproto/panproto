{
  "lexicon": 1,
  "id": "dev.panproto.schema.bundle",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "objectHash", "createdAt"],
        "properties": {
          "name": { "type": "string", "maxLength": 256 },
          "description": { "type": "string", "maxLength": 2560 },
          "theoryCount": { "type": "integer" },
          "morphismCount": { "type": "integer" },
          "compositionCount": { "type": "integer" },
          "protocolCount": { "type": "integer" },
          "objectHash": { "type": "string", "maxLength": 64 },
          "blob": { "type": "blob", "accept": ["application/x-msgpack"], "maxSize": 2097152 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
