}

@inproceedings{mccreeshprosser2015backjumping,
  author    = {Ciaran McCreesh and Patrick Prosser},
  title     = {A parallel, backjumping subgraph isomorphism algorithm using supplemental graphs},
  booktitle = {Principles and Practice of Constraint Programming, {CP} 2015},
  series    = {Lecture Notes in Computer Science},
  volume    = {9255},
  pages     = {295--312},
