}

@article{dempster1967upper,
  author  = {A. P. Dempster},
  title   = {Upper and lower probabilities induced by a multivalued mapping},
  journal = {The Annals of Mathematical Statistics},
  volume  = {38},
  number  = {2},
  pages   = {325--339},
  year    = {1967},
  doi     = {10.1214/aoms/1177698950},
  url     = {https://projecteuclid.org/journals/annals-of-mathematical-statistics/volume-38/issue-2/Upper-and-Lower-Probabilities-Induced-by-a-Multivalued-Mapping/10.1214/aoms/1177698950.full},
  note    = {Verified via the Project Euclid article page and scanned article PDF for DOI 10.1214/aoms/1177698950, whose printed folios run 325--339. Shows that a multivalued mapping carries a probability measure on one space into a system of upper and lower probabilities on another, and gives the rule for conditioning and for combining sources of information that later became the Dempster--Shafer combination rule. Section 5, on page 335, states the precondition the rule is built on: ``The mechanism adopted here assumes independence of the sources'', and adds that ``Opinions of different people based on overlapping experiences could not be regarded as independent sources.''}
}

@inproceedings{dorahm2002coma,
  author    = {Hong-Hai Do and Erhard Rahm},
  title     = {{COMA}---a system for flexible combination of schema matching approaches},
  booktitle = {Proceedings of the 28th International Conference on Very Large Data Bases ({VLDB} 2002)},
