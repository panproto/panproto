@article{bancilhonspyratos1981update,
  author  = {F. Bancilhon and N. Spyratos},
  title   = {Update semantics of relational views},
  journal = {{ACM} Transactions on Database Systems},
  volume  = {6},
  number  = {4},
  pages   = {557--575},
  year    = {1981},
