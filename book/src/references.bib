  note    = {Verified via CrossRef DOI 10.1145/319628.319634, whose ACM-deposited record carries the abstract. Defines a translator as a map sending each view update to a database update, introduces the complementary view from which the database can be reconstructed alongside the user's view, and proves that a complete set of view updates admits a translator exactly when it is translatable under constant complement.}
}

@article{bistarellimontanarirossi1997semiring,
  author  = {Stefano Bistarelli and Ugo Montanari and Francesca Rossi},
  title   = {Semiring-based constraint satisfaction and optimization},
  journal = {Journal of the {ACM}},
  volume  = {44},
  number  = {2},
  pages   = {201--236},
  year    = {1997},
  doi     = {10.1145/256303.256306},
  url     = {https://dl.acm.org/doi/10.1145/256303.256306},
  note    = {Verified via CrossRef DOI 10.1145/256303.256306, whose ACM-deposited record carries the abstract. Gives a semiring framework into which classical, fuzzy, weighted and partial constraint satisfaction all embed: the semiring's carrier supplies the values attached to tuples, and its two operations model constraint projection and constraint combination.}
}

@article{cooperdegivrysanchezschiexzytnickiwerner2010soft,
  author  = {M. C. Cooper and S. de Givry and M. Sanchez and T. Schiex and M. Zytnicki and T. Werner},
  title   = {Soft arc consistency revisited},
  journal = {Artificial Intelligence},
  volume  = {174},
  number  = {7-8},
  pages   = {449--478},
  year    = {2010},
  doi     = {10.1016/j.artint.2010.02.001},
  url     = {https://doi.org/10.1016/j.artint.2010.02.001},
  note    = {Verified via CrossRef DOI 10.1016/j.artint.2010.02.001 and the published Elsevier article PDF hosted by the authors' laboratory at irit.fr/publis/ADRIA/VAC\_OSAC\_final.pdf. Extends arc consistency for cost function networks by admitting fractional weights and simultaneous operations, shows that over the rationals an optimal soft arc consistency closure is computable in polynomial time by reduction to linear programming, and derives Virtual Arc Consistency, which detects a cost-increasing sequence of operations by enforcing arc consistency on a derived classical CSP and which solves submodular cost functions.}
}

@article{cooperschiex2004arc,
  author  = {Martin Cooper and Thomas Schiex},
  title   = {Arc consistency for soft constraints},
  journal = {Artificial Intelligence},
  volume  = {154},
  number  = {1-2},
  pages   = {199--227},
  year    = {2004},
  doi     = {10.1016/j.artint.2003.09.002},
  url     = {https://doi.org/10.1016/j.artint.2003.09.002},
  note    = {Verified via CrossRef DOI 10.1016/j.artint.2003.09.002 and the arXiv preprint cs/0111038v3, whose full text was read for the statements cited here; the preprint numbering is given below because the published numbering was not seen. Extends arc consistency to valued CSP over any fair valuation structure, fairness being the condition that every pair a below b admits a unique maximal difference b minus a (Definition 3.1), from which follows the identity (u + w) + (v - w) = u + v for w below v (Lemma 3.2) that lets the Project and Extend operations move cost between a constraint and a domain without changing the valuation of any assignment. Gives an enforcing algorithm valid over any fair structure, including the non-idempotent operators of Max-CSP, and a directional version that solves tree-structured soft constraint problems.}
}

@article{dechter1999bucket,
  author  = {Rina Dechter},
  title   = {Bucket elimination: a unifying framework for reasoning},
  journal = {Artificial Intelligence},
  volume  = {113},
  number  = {1-2},
  pages   = {41--85},
  year    = {1999},
  doi     = {10.1016/S0004-3702(99)00059-4},
  url     = {https://www.sciencedirect.com/science/article/pii/S0004370299000594},
  note    = {Verified via CrossRef DOI 10.1016/S0004-3702(99)00059-4 and the published Elsevier article PDF hosted by the author at ics.uci.edu/\~{}dechter/publications/r76A.pdf. Shows that directional resolution, adaptive consistency, Fourier and Gaussian elimination, dynamic programming for combinatorial optimisation, and several probabilistic inference tasks are one algorithm under different combination operators, all of them time and space exponential in the induced width of the problem's interaction graph, and shows how conditioning search trades space back for time.}
}

@article{dechterpearl1987network,
  author  = {Rina Dechter and Judea Pearl},
  title   = {Network-based heuristics for constraint-satisfaction problems},
  journal = {Artificial Intelligence},
  volume  = {34},
  number  = {1},
  pages   = {1--38},
  year    = {1987},
  doi     = {10.1016/0004-3702(87)90002-6},
  url     = {https://doi.org/10.1016/0004-3702(87)90002-6},
  note    = {Verified via CrossRef DOI 10.1016/0004-3702(87)90002-6 and the published Elsevier article PDF at ics.uci.edu/\~{}csp/r3.pdf. Identifies the classes of constraint networks that are easy because the constraint graph is sparse or a tree, gives algorithms that solve those optimally, and derives value-ordering advice by relaxing the pending subproblem to a tree and counting its consistent solutions. The offprint carries a 1988 Elsevier imprint; the issue is dated 1987, which is the year the publisher deposited.}
}

@inproceedings{degivryheraszytnickilarrosa2005existential,
  author    = {Simon de Givry and Federico Heras and Matthias Zytnicki and Javier Larrosa},
  title     = {Existential arc consistency: getting closer to full arc consistency in weighted {CSPs}},
  booktitle = {Proceedings of the 19th International Joint Conference on Artificial Intelligence ({IJCAI} 2005)},
  pages     = {84--89},
  year      = {2005},
  url       = {https://www.ijcai.org/Proceedings/05/Papers/0827.pdf},
