  note    = {Verified via CrossRef DOI 10.1017/S0960129511000442; published online 19 September 2011, print issue February 2012. Lifts lenses from sets and ordered sets to categories, shows that constant-complement view updating corresponds to lenses in categorical database models, and identifies c-lenses with Grothendieck opfibrations, which supply a universal solution to the view update problem for functorial views.}
}

@inproceedings{larrosa2002node,
  author    = {Javier Larrosa},
