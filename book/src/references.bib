  note      = {Verified via the IJCAI 2017 proceedings page for DOI 10.24963/ijcai.2017/99. Introduces the branch and bound algorithm for maximum common subgraph and maximum common connected subgraph that branches on vertex labelling and partitions the domains, with a compact domain store and supporting inference, reporting speedups above an order of magnitude and much larger tractable instances than clique-encoding methods.}
}

@inproceedings{meilickestuckenschmidt2007analyzing,
  author    = {Christian Meilicke and Heiner Stuckenschmidt},
  title     = {Analyzing mapping extraction approaches},
  booktitle = {Proceedings of the 2nd International Workshop on Ontology Matching ({OM} 2007), collocated with {ISWC} 2007},
