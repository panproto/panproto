@article{freuder1982sufficient,
  author  = {Eugene C. Freuder},
  title   = {A sufficient condition for backtrack-free search},
  journal = {Journal of the {ACM}},
  volume  = {29},
  number  = {1},
  pages   = {24--32},
  year    = {1982},
  doi     = {10.1145/322290.322292},
