}

@article{grohe2007complexity,
  author  = {Martin Grohe},
  title   = {The complexity of homomorphism and constraint satisfaction problems seen from the other side},
  journal = {Journal of the {ACM}},
  volume  = {54},
  number  = {1},
  pages   = {1:1--1:24},
  year    = {2007},
  doi     = {10.1145/1206035.1206036},
  url     = {https://dl.acm.org/doi/10.1145/1206035.1206036},
  note    = {Verified via CrossRef DOI 10.1145/1206035.1206036, whose ACM-deposited record carries the abstract. Classifies homomorphism problems by restricting the left-hand structure rather than the right, shows that under standard parameterised-complexity assumptions HOM(C, -) is in polynomial time if and only if C has bounded treewidth \emph{modulo homomorphic equivalence}, and transfers the classification to constraint satisfaction and to conjunctive query evaluation over relational databases. The qualifier is load-bearing: a class of unbounded treewidth whose cores have bounded treewidth is tractable, so the theorem constrains the cores rather than the structures.}
}

@inproceedings{johnsonrosebrugh2014spans,
  author    = {Michael Johnson and Robert Rosebrugh},
  title     = {Spans of lenses},
  booktitle = {Proceedings of the Workshops of the {EDBT/ICDT} 2014 Joint Conference},
