@inproceedings{schiexfargierverfaillie1995valued,
  author    = {Thomas Schiex and H{\'e}l{\`e}ne Fargier and G{\'e}rard Verfaillie},
  title     = {Valued constraint satisfaction problems: hard and easy problems},
  booktitle = {Proceedings of the 14th International Joint Conference on Artificial Intelligence ({IJCAI} 1995)},
