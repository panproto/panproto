@inproceedings{mccreeshndiayeprossersolnon2016clique,
  author    = {Ciaran McCreesh and Samba Ndojh Ndiaye and Patrick Prosser and Christine Solnon},
  title     = {Clique and constraint models for maximum common (connected) subgraph problems},
  booktitle = {Principles and Practice of Constraint Programming ({CP} 2016)},
  series    = {Lecture Notes in Computer Science},
  volume    = {9892},
  pages     = {350--368},
  publisher = {Springer International Publishing},
  year      = {2016},
  doi       = {10.1007/978-3-319-44953-1_23},
  url       = {https://perso.liris.cnrs.fr/christine.solnon/publications/cp16mccs.pdf},
  note      = {Verified via the CrossRef publisher deposit for DOI 10.1007/978-3-319-44953-1\_23, which gives the author order, the 350--368 page range, Springer International Publishing and the 2016 date, and against the authors' copy hosted at LIRIS, from which the technical claims here are read. Compares the constraint model of maximum common subgraph, in which each variable carries a value $\bot$ meaning the vertex is left unmatched, against the reduction to maximum clique, and finds the better choice turns mainly on whether edges are labelled. Section 2.3 records that tighter edge constraints buy the constraint model no filtering while $\bot$ remains in every domain, since $\bot$ supports every value and every pair of variables is therefore arc consistent, and that filtering becomes possible only once $\bot$ is removed.}
}

@inproceedings{mccreeshprossertrimble2017partitioning,
  author    = {Ciaran McCreesh and Patrick Prosser and James Trimble},
  title     = {A partitioning algorithm for maximum common subgraph problems},
  booktitle = {Proceedings of the 26th International Joint Conference on Artificial Intelligence ({IJCAI} 2017)},
