# Mark vendored tree-sitter grammar sources as generated/vendored.
# This keeps GitHub language stats clean and collapses diffs in PRs.
grammars/** linguist-vendored linguist-generated

# Some upstream AT Protocol syntax vectors use a final ASCII space as the
# invalid byte under test. Preserve those bytes without treating them as
# accidental source whitespace.
tests/fixtures/atproto-interop/syntax/*.txt -whitespace

# Generated test corpora: collapse their diffs and keep them out of language
# statistics. The encoded forms are binary.
tests/fixtures/validation/** linguist-generated
tests/fixtures/theory_composition/** linguist-generated
tests/fixtures/complement_upgrade/** linguist-generated
*.cbor binary
*.msgpack binary

# The W3C RDF test suites test exact bytes: line endings, control
# characters and trailing blanks are part of the cases.
crates/panproto-io/tests/fixtures/conformance/rdf-tests/** -text -whitespace linguist-vendored
