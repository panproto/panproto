# ---------------------------------------------------------------------------

class Vertex:
    id: str
    kind: str
    nsid: str | None
    def to_dict(self) -> dict[str, JsonValue]: ...

class Edge:
    src: str
    tgt: str
    kind: str
    name: str | None
    def to_dict(self) -> dict[str, JsonValue]: ...

class HyperEdge:
    id: str
    kind: str
    signature: dict[str, str]
    parent_label: str
    def to_dict(self) -> dict[str, JsonValue]: ...

class Constraint:
    sort: str
    value: str

class Complement:
    @property
    def dropped_node_count(self) -> int: ...
    @property
    def dropped_arc_count(self) -> int: ...
    def to_dict(self) -> dict[str, JsonValue]: ...

class SchemaBuilder:
    def vertex(self, id: str, kind: str, nsid: str | None = ..., /) -> None: ...
    def edge(
        self,
        src: str,
        tgt: str,
        kind: str,
        name: str | None = ...,
    ) -> None: ...
    def hyper_edge(
        self,
        id: str,
        kind: str,
        signature: dict[str, str],
        parent: str,
    ) -> None: ...
    def constraint(self, vertex_id: str, sort: str, value: str) -> None: ...
    def build(self) -> Schema: ...

class Schema:
    vertex_count: int
    edge_count: int
    vertices: list[Vertex]
    edges: list[Edge]
    hyper_edges: list[HyperEdge]
    protocol: str
    def vertex(self, name: str) -> Vertex | None: ...
    def has_vertex(self, name: str) -> bool: ...
    def constraints_for(self, vertex: str) -> list[Constraint]: ...
    def field_text(self, vertex: str, field_name: str) -> str | None: ...
    def incoming_edges(self, vertex: str) -> list[Edge]: ...
    def outgoing_edges(self, vertex: str) -> list[Edge]: ...
    def normalize(self) -> Schema: ...
    def validate(self, protocol: Protocol) -> list[str]: ...
    def to_dict(self) -> dict[str, JsonValue]: ...
    def to_json(self) -> str: ...
    def theory(self, name: str | None = ...) -> Theory: ...
    @staticmethod
    def from_json(json: str) -> Schema: ...
    @staticmethod
    def from_atproto_lexicon(doc: Mapping[str, JsonValue] | str) -> Schema: ...

