# ---------------------------------------------------------------------------

class ParseEmitLens:
    def parse(self, data: bytes) -> Schema: ...
    def emit(self, schema: Schema) -> bytes: ...

class AstParserRegistry:
    # `extra_grammars` is the cross-cdylib transport surface for
    # companion grammar packs. Each dict carries `name`, `extensions`,
    # `language_ptr`, `node_types_ptr`, `node_types_len`, and the
    # optional `tags_query_ptr`/`tags_query_len`/`grammar_json_ptr`/
    # `grammar_json_len` pairs. End users typically don't touch this
    # directly; `panproto.AstParserRegistry()` (the wrapper factory)
    # builds the list from installed companion entry points.
    def __init__(
        self, extra_grammars: Sequence[Mapping[str, object]] | None = ...
    ) -> None: ...
    def protocol_names(self) -> list[str]: ...
    def detect_language(self, path: str) -> str | None: ...
    def parse_with_protocol(
        self, protocol: str, source: bytes, file_path: str = ...
    ) -> Schema: ...
    def parse_file(self, path: str) -> Schema: ...
    def emit(self, protocol: str, schema: Schema) -> bytes: ...
    def emit_pretty(self, protocol: str, schema: Schema) -> bytes: ...
    def lens(self, protocol: str) -> ParseEmitLens: ...

def available_grammars() -> list[str]: ...
def parse_source_file(*args: object, **kwargs: object) -> Schema: ...

