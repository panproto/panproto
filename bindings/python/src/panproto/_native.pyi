"""Type stubs for the ``panproto._native`` extension module.

Hand-written; covers the surface that downstream Python consumers
exercise. Methods/classes not yet stubbed fall back via the
implicit-reexport in ``__init__.py``; extending this file is preferred
over per-callsite ``# type: ignore``.
"""

from collections.abc import Iterable, Mapping, Sequence
from os import PathLike
from typing import Self

type JsonValue = str | int | float | bool | None | list[JsonValue] | dict[str, JsonValue]

