"""Type stubs for the ``panproto._native`` extension module.

Hand-written; covers the surface that downstream Python consumers
(``didactic`` and friends) exercise. Methods/classes not yet stubbed
fall back to ``Any`` via the implicit-reexport in ``__init__.py``;
extending this file is preferred over per-callsite ``# type: ignore``.

Notes
-----
Argument and return types are best-effort and reflect runtime behaviour
of the pyo3 wrapper, not the underlying Rust signatures. Where the
runtime returns a heterogeneous payload (e.g. ``Schema.to_dict`` →
nested ``dict``), the stub uses ``dict[str, object]`` rather than a
narrower union; widen as needed when a caller demands stricter types.
"""

from collections.abc import Iterable, Mapping, Sequence
from os import PathLike
from typing import Self

