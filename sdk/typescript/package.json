{
  "name": "@panproto/core",
  "version": "0.34.1",
  "description": "Schematic version control with panproto (TypeScript SDK)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/panproto-wasm --target web --release --out-dir pkg --out-name panproto_wasm",
    "build:ts": "vite build",
    "build:copy-wasm": "node -e \"import('node:fs/promises').then(async m => { await m.mkdir('dist', { recursive: true }); for (const f of ['panproto_wasm.js', 'panproto_wasm.d.ts', 'panproto_wasm_bg.wasm', 'panproto_wasm_bg.wasm.d.ts']) { await m.copyFile('../../crates/panproto-wasm/pkg/' + f, 'dist/' + f); } })\"",
    "build": "pnpm run build:wasm && pnpm run build:ts && pnpm run build:copy-wasm",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxlint": "^1.60.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/panproto/panproto",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "panproto",
    "schema",
    "migration",
    "wasm",
    "atproto",
    "lens"
  ]
}
